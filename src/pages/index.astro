---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const profile = await getEntry('profile', 'about');
if (!profile) throw new Error('Missing profile content.');
const { Content } = await render(profile);
const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const renderedNews = await Promise.all(news.map(async (item) => ({ item, Content: (await render(item)).Content })));
---

<BaseLayout title={profile.data.name + ' — Academic Website'} description="Personal academic website of Weixuan Ding.">
  <section class="about-home shell">
    <div class="about-copy reveal">
      <p class="eyebrow">About me</p>
      <div class="about-body prose"><Content /></div>
      <div class="social-links" aria-label="Academic profiles">
        <a href={profile.data.github} target="_blank" rel="noreferrer" aria-label="GitHub profile"><img src="/icons/github.svg" alt="" width="22" height="22" /></a>
        <a href={profile.data.scholar} target="_blank" rel="noreferrer" aria-label="Google Scholar profile"><img src="/icons/googlescholar.svg" alt="" width="22" height="22" /></a>
        <a href={profile.data.orcid} target="_blank" rel="noreferrer" aria-label="ORCID profile"><img src="/icons/orcid.svg" alt="" width="22" height="22" /></a>
      </div>
    </div>

    <aside class="profile-card reveal">
      <div class="profile-image"><img src="/images/profile.png" alt="Portrait of Weixuan Ding" width="664" height="626" /></div>
      <div class="profile-name">
        <h1>{profile.data.name} <span>({profile.data.nameChinese})</span></h1>
        <p>Preferred name · {profile.data.preferredName}</p>
      </div>
      <div class="profile-contact">
        <a href={'mailto:' + profile.data.email}><img class="contact-icon" src="/icons/mail.svg" alt="" width="18" height="18" />{profile.data.email}</a>
        <p><img class="contact-icon" src="/icons/map-pin.svg" alt="" width="18" height="18" />{profile.data.location}</p>
      </div>
    </aside>
  </section>

  <section class="news-section shell reveal" aria-labelledby="news-heading">
    <div class="news-heading"><p class="eyebrow">Updates</p><h2 id="news-heading">News</h2></div>
    <div class="news-list">
      {renderedNews.map(({ item, Content: NewsContent }) => (
        <article>
          <time datetime={item.data.date.toISOString()}>{item.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
          <div class="news-copy"><NewsContent /></div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
